#!/usr/bin/env bash
# anvil: find a working Python 3 and run the Anvil CLI (plugins/anvil/bin/anvil_cli).
# Tries python, then py -3, then python3, skipping the Microsoft Store stubs
# (any path containing WindowsApps). Runs Python with -I, which ignores
# PYTHONPATH, so bin/ is put on sys.path by the -c bootstrap instead.
case "$0" in
  */*|*\\*) BIN_DIR="${0%[/\\]*}" ;;
  *) BIN_DIR=. ;;
esac
# pwd -W gives a Windows path under Git Bash; plain pwd elsewhere.
BIN_DIR=$(cd "$BIN_DIR" && { pwd -W 2>/dev/null || pwd; })

PY=()
# Every hit on PATH, not only the first: a WindowsApps stub may come before a real one.
for c in python py python3; do
  while IFS= read -r p; do
    case "$p" in ""|*WindowsApps*) continue ;; esac
    if [ "$c" = py ]; then PY=("$p" -3); else PY=("$p"); fi
    break 2
  done < <(type -ap "$c" 2>/dev/null)
done
if [ ${#PY[@]} -eq 0 ]; then
  echo "anvil: no working Python found (tried python, py -3, python3)" >&2
  exit 1
fi

# Git Bash rewrites arguments that look like POSIX paths ("/clear the cache")
# when it starts a Windows program. Pass arguments through unchanged.
export MSYS_NO_PATHCONV=1 MSYS2_ARG_CONV_EXCL='*'
exec "${PY[@]}" -I -c 'import sys;sys.path.insert(0,sys.argv.pop(1));from anvil_cli.cli import main;sys.exit(main())' "$BIN_DIR" "$@"
