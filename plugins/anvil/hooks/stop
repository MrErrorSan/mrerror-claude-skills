#!/usr/bin/env bash
# adapted from superpowers@7.0.2: hooks/session-start
# Anvil Stop hook: runs `bin/anvil hook stop` on the hook JSON from stdin.
# It runs bin/anvil with this same bash ($BASH), not a PATH lookup, because a WSL
# bash.exe can come first on PATH on Windows. Fails open: if the CLI is missing,
# finds no Python or exits non-zero, this prints {} and one line on stderr.
# Fast path: with no active Anvil topic there is nothing to hold, reuse or keep going,
# so answer without starting Python (this hook runs on every Edit, Write and Bash call).
gd=$(git rev-parse --git-common-dir 2>/dev/null) || { echo '{}'; exit 0; }
a="$gd/anvil/active.json"
if [ ! -s "$a" ] || [ "$(head -c 4 "$a")" = "null" ]; then echo '{}'; exit 0; fi
case "$0" in */*|*\\*) d="${0%[/\\]*}" ;; *) d=. ;; esac
{ err=$("${BASH:-bash}" "$d/../bin/anvil" hook stop 2>&1 1>&3 3>&-); } 3>&1
if [ $? -ne 0 ]; then echo '{}'; echo "anvil: stop hook skipped: ${err##*$'\n'}" >&2
elif [ -n "$err" ]; then echo "${err##*$'\n'}" >&2; fi
exit 0
